{$ECNIVS_SITE_HOST} {
	root * {$ECNIVS_SITE_ROOT}
	encode zstd gzip
	@immutable path_regexp asset ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2|svg|png|webp|avif)$
	@revalidate {
		not path_regexp asset ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2|svg|png|webp|avif)$
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"
	header X-Content-Type-Options nosniff
	file_server {
		precompressed br gzip
	}
}
